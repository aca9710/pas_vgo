# Plantilla de configuracion de la API (pasarela).
# Copiar a .env y ajustar:
#   cp .env.example .env
#
# config.Load() busca ".env" en el directorio de trabajo y, si no existe,
# "../.env" (raiz del repo). Si una variable falta o esta vacia se usa el
# valor por defecto de config/config.go.

# --- Database ---
# DSN de PostgreSQL. Requerido: la API no arranca sin el.
DSN=postgres://usuario:password@localhost:5432/pasarela?sslmode=disable

# Tamano del pool de conexiones pgx (por defecto 10 / 100).
PG_MIN_SIZE=10
PG_MAX_SIZE=100

# --- API ---
# Interfaz y puerto de escucha del servidor HTTP (por defecto 0.0.0.0 / 5081).
API_HOST=0.0.0.0
API_PORT=5081

# Modo debug (por defecto false). Acepta los valores de strconv.ParseBool:
# true, false, 1, 0, t, f, T, F, TRUE, FALSE, True, False.
DEBUG=false

# --- URLs ---
# Base de la pasarela (se usa para construir UrlResponse en las pruebas).
PASARELA_URL=http://localhost:5081

# Endpoints del servicio externo de pagos (ETECSA).
ORDENPAGO=
DEVOLUCION=

# Endpoints de consulta de estado.
ESTADODEVOL=
ESTADOORDEN=

# Callback para notificar el estado de un pago al origen.
NOTIF_PAGO=

# Plantilla de URL de respuesta para devoluciones.
URL_RES_DEVOL=

# --- Auth ---
# Clave de firma de sesiones. Generar un valor aleatorio en produccion,
# por ejemplo: openssl rand -base64 32
SECRET_KEY=cambiar-por-un-valor-aleatorio

# Semilla usada para derivar las credenciales (SHA512 + base64) de origen.
SEMILLA_AUTH=cambiar-por-un-valor-aleatorio

# --- Redis ---
# Redis es usado para las colas listaid y por_notificar.
REDIS_DSN=redis://localhost:6379/0
